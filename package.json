{
  "name": "seriesoftubes",
  "version": "1.27.2",
  "description": "A cartoon browser game about building the internet.",
  "private": true,
  "license": "MIT",
  "homepage": "https://seriesoftub.es/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjaeckel/seriesoftubes.git"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build": "bash scripts/build.sh",
    "i18n:check": "node scripts/i18n-check.js",
    "serve": "npm run build && npx --yes serve@14.2.4 _site",
    "test:quiet": "node --test --test-concurrency=1 --test-reporter=dot tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "24.1.3"
  }
